{
  "name": "@srenauld/camera-macos",
  "version": "0.0.1",
  "files": ["README.md", "LICENSE", "CHANGELOG.md", "package.json", "dist/**", "src/**", "tsconfig.json"],
  "main": "./dist/public/index.js",
  "types": "./dist/public/index.d.ts",
  "scripts": {
    "pretest": "node node_modules/typescript/lib/tsc.js --build ../camera-dji/tsconfig.build.json",
    "test": "jest --forceExit",
    "build": "tsc --build tsconfig.build.json",
    "build:noble": "node node_modules/node-gyp/bin/node-gyp.js rebuild --directory node_modules/@abandonware/noble",
    "postinstall": "yarn build:noble",
    "lint:rules": "eslint .",
    "lint:code-format": "prettier --check \"{src,__mocks__,.rnstorybook}/**/*.{js,json,md,ts,tsx,yml,yaml}\"",
    "lint:type-check": "tsc",
    "lint": "yarn lint:rules && yarn lint:code-format && yarn lint:type-check",
    "lint:fix": "yarn lint:rules --fix && yarn lint:code-format --write && yarn lint:type-check",
    "start": "TS_NODE_BASEURL=./tsconfig.app.json ts-node -r tsconfig-paths/register src/main.ts"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "transformIgnorePatterns": [
      "node_modules/(?!variables/.*)"
    ]
  },
  "peerDependencies": {
    "@srenauld/camera-core": "*",
    "@abandonware/noble": "^1.9.2-26"
  },
  "devDependencies": {
    "@abandonware/noble": "^1.9.2-26",
    "@eslint-react/eslint-plugin": "^5.18.3",
    "@jest/globals": "^30.2.0",
    "@srenauld/camera-core": "workspace:*",
    "@srenauld/camera-dji": "workspace:*",
    "@types/jest": "^30.0.0",
    "@types/noble": "^0.0.44",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.0.1",
    "eslint-plugin-perfectionist": "^5.6.0",
    "eslint-plugin-project-structure": "^3.14.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.0",
    "eslint-plugin-react-you-might-not-need-an-effect": "^0.9.1",
    "eslint-plugin-testing-library": "^7.6.3",
    "eslint-plugin-unicorn": "^63.0.0",
    "jest": "^30.2.0",
    "node-gyp": "^13.0.1",
    "prettier": "^3.6.2",
    "ts-jest": "^29.4.6",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0"
  }
}
