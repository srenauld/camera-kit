{
  "extends": "../../tsconfig.base.json",
    "compilerOptions": {
    "outDir": "dist",
    "types": [
      "jest",
      "node"
    ],
    "emitDeclarationOnly": false,
    "rootDir": "src",
    "tsBuildInfoFile": "dist/tsconfig.tsbuildinfo",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "target": "es2021"
  },
  "files": [],
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx"
  ],
  "references": [
    {
      "path": "./tsconfig.build.json"
    }
  ]
}
